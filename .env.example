# ==========================================================
# Lulu Enterprise Onboarding System - Environment Template
# Copy this file to lulu-backend-api/.env and customize values
# ==========================================================

# Server Network Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=lulu_enterprise_db

# Security & Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Manager Admin Credentials
MANAGER_USERNAME=admin
MANAGER_PASSWORD=luluadmin123
